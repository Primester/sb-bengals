{
  "name": "sb-bengals-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run format:check && npm run build && npm run verify:export",
    "format": "prettier --write app components lib *.ts *.json",
    "format:check": "prettier --check app components lib *.ts *.json",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "type": "module"
}
